{
  "name": "Starlight",
  "short_name": "Starlight",
  "description": "Your local assistant",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b0e1a",
  "theme_color": "#12162a",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Kill switch", "short_name": "Stop", "description": "Stop everything Starlight is doing", "url": "/kill",
      "icons": [{ "src": "/kill-icon.svg", "sizes": "any", "type": "image/svg+xml" },
                { "src": "/icons/kill-icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Talk", "description": "Conversation mode", "url": "/?talk=1",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "file", "accept": ["image/*", "application/pdf", "text/*", ".docx", ".xlsx"] }]
    }
  }
}
